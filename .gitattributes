* text=auto
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.S text eol=lf
*.inc text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.patch text eol=lf whitespace=-blank-at-eol
.gitignore text eol=lf
.gitattributes text eol=lf
*.txt text eol=lf
# Preserve formatting in unchanged upstream imports.
src/runtime/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
LICENSES/** whitespace=-blank-at-eol,-blank-at-eof
